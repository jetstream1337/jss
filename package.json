{
  "name": "jss-commissioner",
  "productName": "JSS Commissioner",
  "version": "2.0.0",
  "description": "Commissioner app for Jet's Sim Series, a NASCAR Racing 2003 league. Publishes the league website to GitHub Pages.",
  "main": "main.js",
  "author": "Jet's Sim Series",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jetssimseries.commissioner",
    "productName": "JSS Commissioner",
    "artifactName": "JSS-Commissioner-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "src/**/*", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JSS Commissioner"
    }
  }
}
